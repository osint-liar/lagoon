 [
    {
        "title": "Calendar Heat Map By Years",
        "id": "calendar-heat-map-years",
        "active": true,
        "route": "/timelines",
        "description": "Calendar Heat Map By Years",
        "sql": "SELECT Date(ContentStartedOn) AS `date`, COUNT(*) AS value FROM ContentSchema WHERE ContentStartedOn IS NOT NULL GROUP BY `date` ORDER BY `date` ASC",
        "dataUrl": "{{WebHost}}v1/analysis-tool/raw-sql?SqlQuery={{SqlQuery}}&CaseManagementUuid={{CaseManagementUuid}}",
        "specification": {
            "range": 12,
            "date": {
              "start": "2023-01-01T00:00:00Z",
              "min": "2023-01-01T00:00:00Z",
              "max": "2024-12-01T00:00:00Z",
              "timezone": "utc"
            },
            "data": {
              "source": [],
              "type": "json",
              "x": "date",
              "y": "value"
            },
            "domain": {
              "type": "year",
              "label": {
                "position": "left",
                "textAlign": "end",
                "width": 50,
                "offset": {
                  "x": -10,
                  "y": 5
                }
              }
            },
            "legend": {
              "show": true,
              "label": "Monthly Totals",
              "width": 150,
              "marginLeft": 10,
              "marginRight": 10
            },
            "verticalOrientation": true,
            "subDomain": {
              "type": "month"
            },
            "scale": {
              "color": {
                "type": "quantize",
                "domain": [50000000, 500000000],
                "scheme": "YlOrRd"
              }
            }
        }
    },
